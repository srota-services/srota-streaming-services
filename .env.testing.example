# Testing server environment (deployed test environment)
# Copy to .env.testing on the test server. localhost is allowed.
# NODE_ENV=testing is separate from Jest (NODE_ENV=test).

NODE_ENV=testing
PORT=8082

TRUST_PROXY=1
SESSION_SECRET=

HEALTH_SUPPORT_EMAIL=no-reply@srota-support.com
HEALTH_SUPPORT_PASSWORD=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streaming_test

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=audiobook
RABBITMQ_MESSAGE_TTL=3600000

BULL_REDIS_HOST=redis://localhost:6379
BULL_JOB_TIMEOUT=3600000
BULL_MAX_ATTEMPTS=3
BULL_BACKOFF_DELAY=30000

STORAGE_PROVIDER=s3
LOCAL_STORAGE_PATH=./storage
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_SIGNED_URL_EXPIRES_IN=3600
HLS_PRESIGNED_URL_EXPIRES_IN=7200

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

HLS_SEGMENT_DURATION=4
TRANSCODING_BITRATES=[64, 128, 256]
STREAMING_CACHE_TTL=3600
STREAMING_BASE_URL=http://localhost:8082

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
LOG_DIR=./logs

HEALTH_CHECK_INTERVAL=30000
TRANSCODING_TIMEOUT=3600000
MAX_TRANSCODING_WORKERS=2
CACHE_TTL=3600

AUTH_SERVICE_URL=http://localhost:8080
APP_SERVICE_URL=http://localhost:8081
JWKS_ENDPOINT=http://localhost:8080/auth/.well-known/jwks.json
