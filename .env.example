# Environment Variables Template
# Copy this file to .env.development and update the values for your environment

NODE_ENV=development
PORT=8083

# Reverse proxy (Express trust proxy hop count)
# Use 0 when hitting Node directly (local dev). Use 1 for a single nginx/LB hop.
TRUST_PROXY=0

SESSION_SECRET=your_session_secret_here

HEALTH_SUPPORT_EMAIL=no-reply@srota-support.com
HEALTH_SUPPORT_PASSWORD=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streaming_dev

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=audiobook
RABBITMQ_MESSAGE_TTL=3600000

BULL_REDIS_HOST=redis://localhost:6379
BULL_JOB_TIMEOUT=3600000
BULL_MAX_ATTEMPTS=3
BULL_BACKOFF_DELAY=30000

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_SIGNED_URL_EXPIRES_IN=3600
HLS_PRESIGNED_URL_EXPIRES_IN=7200

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

HLS_SEGMENT_DURATION=4
TRANSCODING_BITRATES=[64, 128, 256]
STREAMING_CACHE_TTL=3600
STREAMING_BASE_URL=http://localhost:8083

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=debug
LOG_DIR=./logs

HEALTH_CHECK_INTERVAL=30000
TRANSCODING_TIMEOUT=3600000
MAX_TRANSCODING_WORKERS=2
CACHE_TTL=3600

AUTH_SERVICE_URL=http://localhost:8080
APP_SERVICE_URL=http://localhost:8081
JWKS_ENDPOINT=http://localhost:8080/auth/.well-known/jwks.json
