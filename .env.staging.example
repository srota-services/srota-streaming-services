# Staging Environment Variables Template
# Copy to .env.staging on the staging server and replace placeholders with real values.
# localhost and 127.0.0.1 are not allowed in staging.

NODE_ENV=staging
PORT=8082

TRUST_PROXY=1
SESSION_SECRET=

HEALTH_SUPPORT_EMAIL=no-reply@srota-support.com
HEALTH_SUPPORT_PASSWORD=

DATABASE_URL=postgresql://user:password@db.staging.internal:5432/streaming_staging

REDIS_URL=redis://redis.staging.internal:6379
REDIS_PASSWORD=

RABBITMQ_URL=amqp://user:password@rabbitmq.staging.internal:5672
RABBITMQ_QUEUE_PREFIX=audiobook
RABBITMQ_MESSAGE_TTL=3600000

BULL_REDIS_HOST=redis://redis.staging.internal:6379
BULL_JOB_TIMEOUT=3600000
BULL_MAX_ATTEMPTS=3
BULL_BACKOFF_DELAY=30000

STORAGE_PROVIDER=s3
LOCAL_STORAGE_PATH=./storage
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_SIGNED_URL_EXPIRES_IN=3600
HLS_PRESIGNED_URL_EXPIRES_IN=7200

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

HLS_SEGMENT_DURATION=4
TRANSCODING_BITRATES=[64, 128, 256]
STREAMING_CACHE_TTL=3600
STREAMING_BASE_URL=https://streaming.staging.internal

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
LOG_DIR=./logs

HEALTH_CHECK_INTERVAL=30000
TRANSCODING_TIMEOUT=3600000
MAX_TRANSCODING_WORKERS=2
CACHE_TTL=3600

AUTH_SERVICE_URL=https://auth.staging.internal
APP_SERVICE_URL=https://app.staging.internal
JWKS_ENDPOINT=https://auth.staging.internal/auth/.well-known/jwks.json
